profile home {
    output eDP-1 disable
    output 'LG Electronics LG HDR 4K 0x000246E2' enable mode 3840x2160 position 0,0 scale 1.2
    exec bluetoothctl power on
    exec pkill -9 wl-mirror >/dev/null 2>&1
}

profile office {
    output eDP-1 disable
    output 'HP Inc. HP 527pu CNC5061RBG' enable mode 2560x1440 position 0,0
#     output eDP-1 enable mode 1920x1200 position 0,1440
#     output 'HP Inc. HP 527pu CNC5061RBG' disable
    exec bluetoothctl power on
    exec pkill -9 wl-mirror >/dev/null 2>&1
}

profile laptop {
    output eDP-1 enable mode 1920x1200 position 0,0
    exec bluetoothctl power off
    exec pkill -9 wl-mirror >/dev/null 2>&1
}

profile slides {
    output eDP-1 enable mode 1920x1200 position 0,0
    output "*" enable position 1920,0
}
