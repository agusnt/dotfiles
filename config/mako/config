# ~/.config/mako/config

font=Lilex Nerd Font Mono 12
text-color=#ebdbb2
background-color=#1d2021
border-color=#d79921
border-size=2
border-radius=10
padding=12
margin=10
width=400
height=150

anchor=top-right
layer=overlay
max-visible=3
max-history=20
group-by=app-name

icons=1
max-icon-size=32
markup=1
format=<b>%s</b>\n%b
text-alignment=left
actions=1
default-timeout=5000

[urgency=low]
border-color=#928374
default-timeout=3000

[urgency=critical]
border-color=#fb4934
background-color=#282828
default-timeout=0

[mode=do-not-disturb]
invisible=1
