# For output configuration, I rely on Kanshi.
#
# Machine-independent config: no hardcoded outputs, LEDs or paths.
# Per-machine specifics (displays) live in kanshi; optional bits
# (trackpoint, media keys) are simply ignored if missing.
#
# Layout: this file holds the variables; everything else is split by topic
# in config.d/*.conf (loaded in alphabetical order).
#
# @Author: Navarro-Torres, Agustin

# Scripts and utilities
set $sway ~/.config/sway
set $scripts $sway/scripts
set $bar $sway/bar/bar.sh
set $dashboard $sway/dashboard/dashboard.sh
set $net ~/.local/bin/network.sh
set $cheatsheet $sway/cheatsheet/cheatsheet.sh

# Colour palette (generated by ~/.config/colors/apply.sh)
include ~/.config/sway/colors.conf

# Start graphical session
exec $scripts/start-systemd-session.sh

##################################################
# Vars
##################################################
# Windows key as modifier
set $mod Mod4

# Terminal: footclient if a server is running, else foot (see term.sh)
set $term $scripts/term.sh

# Wofi as launcher
set $menu wofi --allow-images --show drun -a -M fuzzy

# Screen lock (single place for the swaylock options: see lock.sh)
set $lock $scripts/lock.sh

# Set file browser
set $files thunar

# Set password manager
set $pass wofi-pass -i

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Topic files: looks, input, key bindings, window rules, bar, autostart
include ~/.config/sway/config.d/*.conf

# System config (Debian: /etc/sway/config.d/*)
include /etc/sway/config.d/*
